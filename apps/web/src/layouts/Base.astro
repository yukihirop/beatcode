---
import "@fontsource/press-start-2p/400.css";
import "@fontsource/dotgothic16/400.css";
import "@fontsource-variable/geist";
import "@fontsource-variable/jetbrains-mono";
import "../styles/tokens.css";
import "../styles/site.css";
import type { Strings } from "../i18n/strings";

interface Props {
  t: Strings;
  title?: string;
  description?: string;
  /** The page's path under the language root, for the hreflang links: "" or "guide/". */
  path?: string;
}
const { t, path = "" } = Astro.props;
const title = Astro.props.title ?? t.title;
const description = Astro.props.description ?? t.description;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="oklch(15% 0.03 265)" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" hreflang="en" href={`${base}${path}`} />
    <link rel="alternate" hreflang="ja" href={`${base}ja/${path}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(`${base}og.png`, Astro.site ?? Astro.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>
