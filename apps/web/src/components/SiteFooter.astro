---
import type { Strings } from "../i18n/strings";

interface Props {
  t: Strings;
}
const { t } = Astro.props;
---

<footer class="foot">
  <p>{t.footer.license}</p>
  <p class="foot__links">
    {t.footer.links.map((l) => <a href={l.href}>{l.label}</a>)}
  </p>
  <p class="foot__copy"><small>{t.footer.copyright}</small></p>
</footer>
