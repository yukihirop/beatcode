---
import Base from "../layouts/Base.astro";
import Highway from "./Highway.astro";
import Install from "./Install.astro";
import Wordmark from "./Wordmark.astro";
import type { Strings } from "../i18n/strings";

interface Props {
  t: Strings;
}
const { t } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const keys = ["D", "F", "J", "K"];
const laneClass = ["kw", "id", "op", "lit"];
const sample: [string, number][] = [
  ["let", 0], ["combo", 1], ["=", 2], ["combo", 1], ["+", 2], ["1", 3], [";", 2],
];
const repo = t.footer.links[0].href;
---

<Base t={t}>
  <header class="nav">
    <a class="wordmark" href={base}><Wordmark /></a>
    <nav class="nav__end" aria-label="Site">
      <a class="nav__link" href={`${base}${t.otherLang.href}`} lang={t.htmlLang === "en" ? "ja" : "en"}>{t.otherLang.label}</a>
      <a class="btn btn--ghost" href={repo}>{t.github}</a>
    </nav>
  </header>

  <main>
    <section class="hero">
      <div class="hero__text">
        <h1 class="hero__title">{t.hero.title}</h1>
        <p class="hero__lede">{t.hero.lede}</p>
        <Install t={t.hero} />
      </div>
      <div class="hero__proof">
        <Highway t={t.highway} />
      </div>
    </section>

    <section class="split" aria-labelledby="lanes-heading">
      <div class="split__text">
        <h2 id="lanes-heading">{t.lanes.heading}</h2>
        <p>{t.lanes.body}</p>
        <p class="muted">{t.lanes.comments}</p>
      </div>
      <div class="split__proof lanes">
        <p class="lanes__sample" aria-hidden="true">
          {sample.map(([text, lane]) => <span class={`tok tok--${laneClass[lane]}`}>{text}</span>)}
        </p>
        <ol class="lanes__list">
          {t.lanes.names.map((name, i) => (
            <li class={`lane lane--${laneClass[i]}`}>
              <kbd>{keys[i]}</kbd>
              <span>{name}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="split split--flip" aria-labelledby="plays-heading">
      <div class="split__text">
        <h2 id="plays-heading">{t.plays.heading}</h2>
      </div>
      <dl class="split__proof spec">
        {t.plays.rows.map((row) => (
          <div class="spec__row">
            <dt>{row.label}</dt>
            <dd>{row.body}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="split" aria-labelledby="start-heading">
      <div class="split__text">
        <h2 id="start-heading">{t.start.heading}</h2>
        <h3>{t.start.keysHeading}</h3>
        <p class="keys" aria-hidden="true">
          {keys.map((k, i) => <kbd class={`lane--${laneClass[i]}`}>{k}</kbd>)}
        </p>
        <p>{t.start.keys}</p>
        <p class="muted">{t.start.ime}</p>
      </div>
      <table class="split__proof commands">
        <tbody>
          {t.start.commands.map((c) => (
            <tr>
              <th scope="row"><code>{c.cmd}</code></th>
              <td>{c.does}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="split split--flip" aria-labelledby="runs-heading">
      <div class="split__text">
        <h2 id="runs-heading">{t.runs.heading}</h2>
      </div>
      <dl class="split__proof spec">
        {t.runs.rows.map((row) => (
          <div class="spec__row">
            <dt>{row.label}</dt>
            <dd>{row.body}</dd>
          </div>
        ))}
      </dl>
    </section>
  </main>

  <footer class="foot">
    <p>{t.footer.license}</p>
    <p>{t.footer.spotify}</p>
    <p class="foot__links">
      {t.footer.links.map((l) => <a href={l.href}>{l.label}</a>)}
    </p>
    <p class="foot__copy"><small>{t.footer.copyright}</small></p>
  </footer>
</Base>
