---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Lang, Strings } from "../i18n/strings";

interface Props {
  t: Strings["demo"];
  lang: Lang;
}
const { t, lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
// The first frame of the clip, one per UI language
const posters = import.meta.glob<{ default: ImageMetadata }>("../assets/demo/*.png", { eager: true });
const poster = await getImage({ src: posters[`../assets/demo/${lang}.png`].default, format: "webp", width: 1320 });
---

<section class="demo" aria-labelledby="demo-heading">
  <div class="demo__text">
    <h2 id="demo-heading">{t.heading}</h2>
    <p>{t.body}</p>
  </div>
  <figure class="demo__figure">
    <div class="demo__frame">
      <video
        class="demo__video"
        src={`${base}demo/${lang}.mp4`}
        poster={poster.src}
        width="1320"
        height="850"
        controls
        playsinline
        preload="none"
        aria-label={t.label}
        data-demo
      ></video>
      <button class="demo__play" type="button" data-demo-play>
        <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M4 2.5v11l9.5-5.5z" />
        </svg>
        <span>{t.play}</span>
      </button>
    </div>
    <figcaption>{t.caption}</figcaption>
  </figure>
</section>

<script>
  // Start with sound on the first press; after that the video's own controls take over.
  document.querySelectorAll<HTMLButtonElement>("[data-demo-play]").forEach((btn) => {
    const video = btn.parentElement?.querySelector<HTMLVideoElement>("video[data-demo]");
    if (!video) return;
    const hide = () => btn.remove();
    btn.addEventListener("click", () => {
      video.muted = false;
      video.play().catch(() => {});
      hide();
      video.focus();
    });
    video.addEventListener("play", hide, { once: true });
  });
</script>
