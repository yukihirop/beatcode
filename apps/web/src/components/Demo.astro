---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Lang, Strings } from "../i18n/strings";

interface Props {
  t: Strings["demo"];
  lang: Lang;
  // "demo": the 30-second untouched recording. "intro": the edited 93-second intro video (2026-11-15)
  kind?: "demo" | "intro";
}
const { t, lang, kind = "demo" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
// The poster, one per UI language: the clip's first frame (demo) or the logo scene (intro)
const posters = import.meta.glob<{ default: ImageMetadata }>("../assets/{demo,intro}/*.png", { eager: true });
const poster = await getImage({ src: posters[`../assets/${kind}/${lang}.png`].default, format: "webp", width: 1320 });
const size = kind === "intro" ? { width: 1920, height: 1080 } : { width: 1320, height: 850 };
---

<section class="demo" aria-labelledby={`${kind}-heading`}>
  <div class="demo__text">
    <h2 id={`${kind}-heading`}>{t.heading}</h2>
    <p>{t.body}</p>
  </div>
  <figure class="demo__figure">
    <div class="demo__frame">
      <video
        class="demo__video"
        src={`${base}${kind}/${lang}.mp4`}
        poster={poster.src}
        width={size.width}
        height={size.height}
        controls
        playsinline
        preload="none"
        aria-label={t.label}
        data-demo
      ></video>
      <button class="demo__play" type="button" data-demo-play>
        <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M4 2.5v11l9.5-5.5z" />
        </svg>
        <span>{t.play}</span>
      </button>
    </div>
    <figcaption>{t.caption}</figcaption>
  </figure>
</section>

<script>
  // Start with sound on the first press; after that the video's own controls take over.
  document.querySelectorAll<HTMLButtonElement>("[data-demo-play]").forEach((btn) => {
    const video = btn.parentElement?.querySelector<HTMLVideoElement>("video[data-demo]");
    if (!video) return;
    const hide = () => btn.remove();
    btn.addEventListener("click", () => {
      video.muted = false;
      video.play().catch(() => {});
      hide();
      video.focus();
    });
    video.addEventListener("play", hide, { once: true });
  });
</script>
