---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../layouts/Base.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import type { Guide } from "../i18n/guide";
import { strings, type Lang } from "../i18n/strings";

interface Props {
  lang: Lang;
  g: Guide;
  /** The page's path under the language root, like "guide/". */
  path: string;
}
const { lang, g, path } = Astro.props;
const t = strings[lang];
const home = lang === "ja" ? "ja/" : "";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

// Screenshots recorded with `beatcode record`, one folder per UI language.
const files = import.meta.glob<{ default: ImageMetadata }>("../assets/guide/*/*.png", { eager: true });
const shot = (file: string) => {
  const found = files[`../assets/guide/${lang}/${file}.png`];
  if (!found) throw new Error(`missing screenshot: ${lang}/${file}.png`);
  return found.default;
};
// A step with a recording shows it in place of its first shot, which becomes the poster.
const posters = new Map(
  await Promise.all(
    g.steps
      .filter((s) => s.video)
      .map(async (s) => [s.id, await getImage({ src: shot(s.shots[0].file), format: "webp", width: 1320 })] as const),
  ),
);
const num = (i: number) => String(i + 1).padStart(2, "0");
// "Space / Enter" → [Space] / [Enter]; "D F J K" → [D] [F] [J] [K]; "/" alone is the key itself
const keyCaps = (keys: string) => keys.split(" ");
const sizes = "(min-width: 60rem) 50rem, calc(100vw - 2rem)";
---

<Base t={t} title={g.title} description={g.description} path={path}>
  <SiteHeader t={t} path={path} />

  <main class="guide">
    <header class="guide__head">
      <h1>{g.heading}</h1>
      <p class="guide__lede">{g.lede}</p>
      {g.recorded && <p class="muted">{g.recorded}</p>}
    </header>

    <div class="guide__body">
      <nav class="guide__menu" aria-label={g.menuLabel}>
        <p class="guide__menu-label">{g.menuLabel}</p>
        <ol>
          {g.steps.map((s, i) => (
            <li>
              <a href={`#${s.id}`} data-step-link={s.id}>
                <span class="guide__num">{num(i)}</span>
                <span>{s.menu}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="guide__steps">
        {g.steps.map((s, i) => (
          <section class="step" id={s.id} aria-labelledby={`${s.id}-heading`} data-step>
            <h2 id={`${s.id}-heading`}>
              <span class="step__num">{num(i)}</span>
              <span>{s.title}</span>
            </h2>
            <div class="step__text">
              {s.body.map((p) => <p>{p}</p>)}
              {s.example && (
                <p class="step__example">
                  <span class="step__example-label">{s.example.label}</span>
                  <a href={s.example.href}>{s.example.href.replace(/^https:\/\//, "")}</a>
                  <span class="step__example-note">{s.example.note}</span>
                </p>
              )}
              {s.see && (
                <p class="step__example">
                  <a href={`${base}${home}${s.see.href}`}>{s.see.label}</a>
                </p>
              )}
            </div>
            {s.file && (
              <figure class="step__file">
                <figcaption>
                  <span>{s.file.name}</span>
                  {s.file.copy && (
                    <button type="button" class="btn btn--ghost step__copy" data-copy={s.file.lines.join("\n")} data-copied={t.llms.copied}>
                      <span data-label>{t.llms.copy}</span>
                    </button>
                  )}
                </figcaption>
                <pre class="step__cmd"><code>{s.file.lines.map((l) => <span class="step__out step__out--file">{l || " "}</span>)}</code></pre>
              </figure>
            )}
            {s.cmd && (
              <pre class="step__cmd"><code>{[s.cmd].flat().map((c) => <span class="step__line">{c}</span>)}{s.out?.map((o) => <span class="step__out">{o}</span>)}</code></pre>
            )}
            {s.keys && (
              <dl class="step__keys" aria-label={g.keysLabel}>
                {s.keys.map(([keys, does]) => (
                  <div class="step__key">
                    <dt>
                      {keyCaps(keys).map((k, i, all) => (k === "/" && all.length > 1 ? <span class="step__or">/</span> : <kbd>{k}</kbd>))}
                    </dt>
                    <dd>{does}</dd>
                  </div>
                ))}
              </dl>
            )}
            {s.table && (
              <div class="step__table">
                <table>
                  <thead>
                    <tr>{s.table.head.map((h) => <th scope="col">{h}</th>)}</tr>
                  </thead>
                  <tbody>
                    {s.table.rows.map((r) => (
                      <tr>{r.map((c, i) => (i === 0 ? <th scope="row">{c}</th> : <td>{c}</td>))}</tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            {s.video && (
              <figure class="shot">
                <video
                  class="shot__media"
                  src={`${base}guide/${lang}/play.mp4`}
                  poster={posters.get(s.id)?.src}
                  width="1320"
                  height="1000"
                  muted
                  loop
                  playsinline
                  controls
                  preload="none"
                  aria-label={s.video.label}
                  data-autoplay
                ></video>
                <figcaption>{s.shots[0].caption}</figcaption>
              </figure>
            )}
            {(s.video ? s.shots.slice(1) : s.shots).map((sh) => (
              <figure class:list={["shot", { "shot--narrow": sh.narrow }]}>
                <Image class="shot__media" src={shot(sh.file)} alt={sh.alt} widths={[660, 1320]} sizes={sizes} format="webp" loading="lazy" />
                <figcaption>{sh.caption}</figcaption>
              </figure>
            ))}
          </section>
        ))}
        {g.next && <a class="guide__next" href={`${base}${home}${g.next.href}`}>{g.next.label}</a>}
      </div>
    </div>
  </main>

  <SiteFooter t={t} />
</Base>

<script>
  // Mark the step being read in the menu.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>("[data-step-link]")].map((a) => [a.dataset.stepLink, a]),
  );
  const seen = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        for (const a of links.values()) a.removeAttribute("aria-current");
        links.get(e.target.id)?.setAttribute("aria-current", "step");
      }
    },
    { rootMargin: "-30% 0px -60% 0px" },
  );
  document.querySelectorAll<HTMLElement>("[data-step]").forEach((s) => seen.observe(s));

  // Copy a file's lines (the prompt for a coding agent)
  for (const btn of document.querySelectorAll<HTMLButtonElement>(".step__copy[data-copy]")) {
    const label = btn.querySelector<HTMLElement>("[data-label]")!;
    const idle = label.textContent;
    let timer = 0;
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
      } catch {
        return;
      }
      label.textContent = btn.dataset.copied!;
      btn.dataset.state = "success";
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        label.textContent = idle;
        delete btn.dataset.state;
      }, 1600);
    });
  }

  // Play the recording only while it's on screen, and never under reduced motion.
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const play = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) v.play().catch(() => {});
          else v.pause();
        }
      },
      { threshold: 0.5 },
    );
    document.querySelectorAll<HTMLVideoElement>("video[data-autoplay]").forEach((v) => play.observe(v));
  }
</script>
