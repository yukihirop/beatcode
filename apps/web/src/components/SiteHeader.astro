---
import Wordmark from "./Wordmark.astro";
import type { Strings } from "../i18n/strings";

interface Props {
  t: Strings;
  /** The page's path under the language root: "" for the top page, "guide/" or "guide/more/" for the guides, "philosophy/". */
  path?: string;
}
const { t, path = "" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const home = `${base}${t.htmlLang === "ja" ? "ja/" : ""}`;
const repo = t.footer.links[0].href;
---

<header class="nav">
  <a class="wordmark" href={home}><Wordmark /></a>
  <nav class="nav__pages" aria-label="Site">
    <a class="nav__link" href={`${home}guide/`} aria-current={path === "guide/" ? "page" : path === "guide/more/" ? "true" : undefined}>{t.nav.guide}</a>
    <a class="nav__link" href={`${home}guide/config/`} aria-current={path === "guide/config/" ? "page" : undefined}>{t.nav.config}</a>
    <a class="nav__link" href={`${home}guide/plugins/`} aria-current={path === "guide/plugins/" ? "page" : undefined}>{t.nav.plugins}</a>
    <a class="nav__link" href={`${home}guide/ranking-server/`} aria-current={path === "guide/ranking-server/" ? "page" : undefined}>{t.nav.rankingServer}</a>
    <a class="nav__link" href={`${home}philosophy/`} aria-current={path === "philosophy/" ? "page" : undefined}>{t.nav.philosophy}</a>
  </nav>
  <div class="nav__end">
    <details class="llms" data-llms data-copied={t.llms.copied} data-failed={t.llms.failed}>
      <summary class="nav__link llms__toggle">{t.llms.label}</summary>
      <ul class="llms__menu">
        {t.llms.files.map((f) => (
          <li class="llms__item">
            <span class="llms__file">{f.file}</span>
            <span class="llms__note">{f.note}</span>
            <span class="llms__actions">
              <a class="llms__action" href={`${base}${f.file}`} download={f.file}>{t.llms.download}</a>
              <button type="button" class="llms__action" data-copy-file={`${base}${f.file}`}>
                <span data-label>{t.llms.copy}</span>
              </button>
            </span>
          </li>
        ))}
      </ul>
    </details>
    <a class="nav__link nav__lang" href={`${base}${t.otherLang.href}${path}`} lang={t.htmlLang === "en" ? "ja" : "en"}>
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
        <g fill="none" stroke="currentColor" stroke-width="1.25">
          <circle cx="8" cy="8" r="6.5" />
          <ellipse cx="8" cy="8" rx="2.75" ry="6.5" />
          <path d="M1.5 8h13" />
        </g>
      </svg>
      {t.otherLang.label}
    </a>
    <a class="nav__icon" href={repo} aria-label={t.github} title={t.github}>
      <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" focusable="false">
        <path fill="currentColor" d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" />
      </svg>
    </a>
  </div>
</header>

<script>
  // llms.txt menu: copy a file's whole text, close on Esc or a click outside
  for (const menu of document.querySelectorAll<HTMLDetailsElement>("[data-llms]")) {
    for (const btn of menu.querySelectorAll<HTMLButtonElement>("[data-copy-file]")) {
      const label = btn.querySelector<HTMLElement>("[data-label]")!;
      const idle = label.textContent;
      let timer = 0;
      btn.addEventListener("click", async () => {
        try {
          const res = await fetch(btn.dataset.copyFile!);
          if (!res.ok) throw new Error(String(res.status));
          await navigator.clipboard.writeText(await res.text());
          label.textContent = menu.dataset.copied!;
        } catch {
          label.textContent = menu.dataset.failed!;
        }
        clearTimeout(timer);
        timer = window.setTimeout(() => (label.textContent = idle), 1600);
      });
    }
    document.addEventListener("click", (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    menu.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menu.open) {
        menu.open = false;
        menu.querySelector("summary")!.focus();
      }
    });
  }
</script>
